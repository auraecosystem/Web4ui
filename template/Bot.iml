<?xml version="1.0" encoding="UTF-8"?>
<module type="WEB_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    
    <!-- Main project content -->
    <content url="file://$MODULE_DIR$">
      <excludeFolder url="file://$MODULE_DIR$/build" />
      <sourceFolder url="file://$MODULE_DIR$/lib" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/src" isTestSource="false" />
      
      <!-- External modules -->
      <sourceFolder url="file://$MODULE_DIR$/script_analyzer_bot/lib" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/some_other_module/lib" isTestSource="false" />
    </content>

    <!-- SDKs and core libraries -->
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
    <orderEntry type="library" name="Dart SDK" level="project" />
    <orderEntry type="library" name="Dart Packages" level="project" />
    <orderEntry type="library" name="Flutter Plugins" level="project" />
    
    <!-- Custom libraries / bots -->
    <orderEntry type="library" name="Script Analyzer Bot" level="project" />
    <orderEntry type="library" name="Some Other Plugin" level="project" />

  </component>
</module>
